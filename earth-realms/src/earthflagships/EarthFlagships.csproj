<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>EarthFlagships</AssemblyName>
    <RootNamespace>EarthFlagships</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>1.1.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <VSDir>%APPDATA%\Vintagestory</VSDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="VintagestoryAPI"><HintPath>$(VSDir)\VintagestoryAPI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\shared\RealmGeo.cs" Link="shared\RealmGeo.cs" />
    <Compile Include="..\shared\FlagshipTable.cs" Link="shared\FlagshipTable.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="modinfo.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
